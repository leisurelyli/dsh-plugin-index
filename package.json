{
  "name": "dsh-plugin-index",
  "version": "1.0.0",
  "private": true,
  "description": "Curated DSH (DeepSeek Harness) format-1 plugin market index with standalone generator, validator, static catalog, and local preview server.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
